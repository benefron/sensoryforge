#!/bin/sh
# living-ledger — post-commit hook: keep the ledger in sync automatically.
#
# Runs .claude/hooks/ledger-sync.sh after every commit. If that produced real new
# entries, it commits the ledger — and ONLY the ledger — as a follow-up
# "chore: ledger sync (auto, …)" commit, leaving every other staged or unstaged
# file exactly where it was.
#
# Cannot loop: the follow-up commit is made with LEDGER_SYNC_IN_PROGRESS set (so the
# re-entered hook returns immediately) and carries no trailers of its own (so a later
# sync produces no change from it).
#
# ledger-template-version: 3
set -u

# 1. recursion guard ---------------------------------------------------------
[ -n "${LEDGER_SYNC_IN_PROGRESS:-}" ] && exit 0

GITDIR="$(git rev-parse --git-dir 2>/dev/null)" || exit 0
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0

# 2. mid-operation guard -----------------------------------------------------
for m in REBASE_HEAD rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD BISECT_LOG; do
  if [ -e "$GITDIR/$m" ]; then
    echo "living-ledger: rebase/merge/cherry-pick in progress — ledger sync deferred."
    exit 0
  fi
done

SYNC="$ROOT/.claude/hooks/ledger-sync.sh"
[ -x "$SYNC" ] || exit 0

# 3. the two files the sync may write: the ledger (level 1) and the decisions log
#    (level 2). Both are auto-committed together, and nothing else ever is.
CONF="$ROOT/.claude/ledger.conf"
LEDGER_REL=""
DEC_REL=""
if [ -f "$CONF" ]; then
  LEDGER_REL="$(sed -n 's/^LEDGER_PATH=//p' "$CONF" | head -1)"
  DEC_REL="$(sed -n 's/^DECISIONS_PATH=//p' "$CONF" | head -1)"
fi
if [ -z "$LEDGER_REL" ]; then
  for c in docs_root/LEDGER.md docs/LEDGER.md LEDGER.md; do
    [ -f "$ROOT/$c" ] && { LEDGER_REL="$c"; break; }
  done
fi
[ -n "$LEDGER_REL" ] && [ -f "$ROOT/$LEDGER_REL" ] || exit 0

TRACKED="$LEDGER_REL"
[ -n "$DEC_REL" ] && [ -f "$ROOT/$DEC_REL" ] && TRACKED="$TRACKED $DEC_REL"

dirty() { git -C "$ROOT" status --porcelain -- $TRACKED 2>/dev/null; }

# 4. hand-edit guard: never fold a human's uncommitted edit into an auto commit.
#    Still sync (so the bookmark advances) — just do not commit.
HANDEDITED=0
[ -n "$(dirty)" ] && HANDEDITED=1

# 5. sync ---------------------------------------------------------------------
LEDGER_SYNC_IN_PROGRESS=1 "$SYNC" >/dev/null 2>&1 || true

if [ -n "$(dirty)" ]; then
  if [ "$HANDEDITED" = 1 ]; then
    echo "living-ledger: $LEDGER_REL has uncommitted changes of your own —"
    echo "               not auto-committing. Review and commit it yourself."
    exit 0
  fi
  SHORT="$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || echo '?')"
  SUBJ="$(git -C "$ROOT" log -1 --format=%s 2>/dev/null | cut -c1-50)"
  git -C "$ROOT" add -- $TRACKED 2>/dev/null || true
  # Pathspec form: commits ONLY these paths, ignoring (and preserving) whatever else
  # happens to be staged.
  LEDGER_SYNC_IN_PROGRESS=1 git -C "$ROOT" commit --no-verify -q \
    -m "chore: ledger sync (auto, after $SHORT: $SUBJ)" -- $TRACKED \
    && echo "living-ledger: ledger updated and committed (after $SHORT)."
fi

# 6. keep the cross-repo mirror warm -----------------------------------------
[ -x "$ROOT/.claude/hooks/ledger-rollup.sh" ] && \
  LEDGER_SYNC_IN_PROGRESS=1 "$ROOT/.claude/hooks/ledger-rollup.sh" >/dev/null 2>&1

exit 0
